// Windows resources: icon, application manifest and version info.
// build.rs generates the icon from src/icon_design.rs and rewrites the two
// quoted file names below to absolute paths before compiling.
// Numeric constants are used instead of <windows.h> so this compiles with
// llvm-rc when cross-compiling (RT_MANIFEST = 24, VOS_NT_WINDOWS32 = 0x40004,
// VFT_APP = 1).

1 ICON "disktree.ico"

1 24 "disktree.exe.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "disktree"
            VALUE "FileDescription", "disktree - disk usage treemap"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "disktree"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "disktree.exe"
            VALUE "ProductName", "disktree"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
